// Lint and format for the browser's code: one tool, as ruff is for the server's.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  // Generated by `npm run types`: never edited, so never formatted.
  "files": { "includes": ["**", "!src/api/schema.d.ts"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" } },
  "css": {
    // A rule's declarations stay on its line, as the stylesheets are written; the linter still reads them.
    "formatter": { "enabled": false },
    "parser": { "cssModules": true }
  },
  "linter": {
    "rules": {
      "complexity": {
        // More than three arguments: those past the first one or two go in one object (rules/frontend/react.md, Calls).
        "useMaxParams": { "level": "error", "options": { "max": 3 } }
      },
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "style": {
        // A module's own states come after its base rule, whatever their specificity: order is the reading order.
        "noDescendingSpecificity": "off",
        // Flat, not nested (rules/readable.md, Branches).
        "noNestedTernary": "error",
        // React Aria's own tooltip throws without a trigger's context, which ui/Tooltip gives it.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react-aria-components": {
                "importNames": ["Tooltip", "TooltipTrigger"],
                "message": "A tooltip is ui/Tooltip (rules/frontend/react.md, Where code goes)."
              }
            }
          }
        }
      },
      "suspicious": {
        // A failure goes through sentenceOf, which logs a bug once and says it (rules/frontend/react.md, Errors).
        "noConsole": "error"
      }
    }
  },
  "overrides": [
    {
      // The one home of a tooltip.
      "includes": ["src/ui/Tooltip.tsx"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      // A bug's one log line, and the probe's report of what it measured.
      "includes": ["src/bugs.ts", "e2e/perf.spec.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      // Every end to end test fails on what the Caddyfile's policy refuses, so each takes its `test` from there.
      "includes": ["e2e/**", "!e2e/policy.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@playwright/test": { "importNames": ["test"], "message": "Take `test` from ./policy." }
                }
              }
            }
          }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
