// Lint and format for the browser's code: one tool, as ruff is for the server's.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  // Generated by `npm run types`: never edited, so never formatted.
  "files": { "includes": ["**", "!src/api/schema.d.ts"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" } },
  "css": {
    // A rule's declarations stay on its line, as the stylesheets are written; the linter still reads them.
    "formatter": { "enabled": false },
    "parser": { "cssModules": true }
  },
  "linter": {
    "rules": {
      "complexity": {
        // More than three arguments: those past the first one or two go in one object (rules/frontend/react.md, Calls).
        "useMaxParams": { "level": "error", "options": { "max": 3 } }
      },
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "style": {
        // A module's own states come after its base rule, whatever their specificity: order is the reading order.
        "noDescendingSpecificity": "off"
      }
    }
  },
  "overrides": [
    {
      // Every end to end test fails on what the Caddyfile's policy refuses, so each takes its `test` from there.
      "includes": ["e2e/**", "!e2e/policy.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@playwright/test": { "importNames": ["test"], "message": "Take `test` from ./policy." }
                }
              }
            }
          }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
