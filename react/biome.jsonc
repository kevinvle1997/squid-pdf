{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": { "includes": ["**", "!src/api/schema.d.ts"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" } },
  "css": {
    // Declarations stay on their rule's line, as the stylesheets are written; the linter still reads them.
    "formatter": { "enabled": false },
    "parser": { "cssModules": true }
  },
  "linter": {
    "rules": {
      "complexity": {
        "useMaxParams": { "level": "error", "options": { "max": 3 } }
      },
      "correctness": {
        // CSS Modules' global(), naming one of base.css's keyframes from inside a module.
        "noUnknownFunction": { "level": "error", "options": { "ignore": ["global"] } },
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "style": {
        // A module's states come after its base rule, whatever their specificity: order is the reading order.
        "noDescendingSpecificity": "off",
        "noNestedTernary": "error",
        // React Aria's own tooltip throws without a trigger's context, which ui/Tooltip gives it.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react-aria-components": {
                "importNames": ["Tooltip", "TooltipTrigger"],
                "message": "A tooltip is ui/Tooltip (rules/frontend/react.md, Where code goes)."
              }
            }
          }
        }
      },
      "suspicious": {
        "noConsole": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/ui/Tooltip.tsx"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      "includes": ["src/bugs.ts", "e2e/perf.spec.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      // Each takes its `test` from policy.ts, so it fails on what the Caddyfile's policy refuses.
      "includes": ["e2e/**", "!e2e/policy.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@playwright/test": { "importNames": ["test"], "message": "Take `test` from ./policy." }
                }
              }
            }
          }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
