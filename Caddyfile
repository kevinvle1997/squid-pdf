# The one way in: HTTPS, compression, and a password until the app opens to the public.
{
	# A local run (localhost) signs its own certificate. Nothing in the container needs to
	# trust it, and the container's files are read-only.
	skip_install_trust
	servers {
		# A body sent a trickle at a time holds a connection and an upload open for as long as
		# it lasts, and the app can't tell slow from stalled. Ten minutes for the whole request
		# still brings a file at the app's size limit in over a slow line.
		timeouts {
			read_body 10m
		}
	}
}

{$SQUIDPDF_DOMAIN} {
	# Render's JSON carries its images as base64, which gzip wins back. PDFs are left alone.
	encode zstd gzip

	# Every path, /api/health too. The app never knows, so opening up deletes this block.
	basic_auth {
		{$SQUIDPDF_USER} {$SQUIDPDF_PASSWORD_HASH}
	}

	header {
		# HTTPS only for a year: a browser that has been here never tries plain HTTP.
		Strict-Transport-Security "max-age=31536000"
		# Each reply is the type it says: a browser never guesses a PDF or PNG is a page.
		X-Content-Type-Options "nosniff"
		# Only what the built app loads, all of it from here: its scripts, styles and fonts, the
		# preview's faces, the page images, and the base64 strips render sends. No inline script,
		# so one injected into a page never runs. The one style tag is React Aria's own, for what
		# can be pressed, allowed by its hash: react/src/policy.test.ts fails when a React Aria
		# upgrade changes it, and the browser's console names the new hash. No other site may
		# frame a page, so none can trick a click on it.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'sha256-38RhXrc7EdReTKsOm23ZPOCUgniTUUcjky8QOOrQx6o='; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		# Another site never learns which page a request came from; ours still do.
		Referrer-Policy "same-origin"
		# The app uses none of these, so nothing on a page may ask for them.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), midi=()"
	}

	# No body cap here: the app enforces its own, and must see them.
	handle /api/* {
		reverse_proxy app:8000
	}

	# The rest of the host is the browser app, built into this image (react/Dockerfile).
	handle {
		root * /srv
		# Built files carry a hash of their contents in their name, so they never change.
		@built path /assets/*
		header @built Cache-Control "max-age=31536000, immutable"
		# Any other path is the app's one page.
		try_files {path} /index.html
		file_server
	}
}
