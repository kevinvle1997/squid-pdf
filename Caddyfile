{
	skip_install_trust
	servers {
		# A trickled body holds an upload open; ten minutes still brings a file at the size limit over a slow line.
		timeouts {
			read_body 10m
		}
	}
}

{$SQUIDPDF_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# The hash allows React Aria's style tag.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'sha256-38RhXrc7EdReTKsOm23ZPOCUgniTUUcjky8QOOrQx6o='; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), midi=()"
	}

	# No body cap here: the app enforces its own, and must see them.
	handle /api/* {
		@docs path /api/docs /api/docs/* /api/openapi.json
		respond @docs 404
		reverse_proxy app:8000
	}

	handle /assets/* {
		root * /srv
		# A 404 isn't kept: a later build's file must still be found.
		@built file
		header @built Cache-Control "max-age=31536000, immutable"
		file_server {
			precompressed br
		}
	}

	# Checked on each visit, so a deploy never leaves a browser on a page whose files are gone.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
