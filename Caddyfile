# The one way in: HTTPS, compression, and a password until the app opens to the public.
{
	# Nothing here needs to trust a local run's certificate, and the container is read-only.
	skip_install_trust
	servers {
		# A body sent a trickle at a time holds a connection and an upload open for as long as
		# it lasts, and the app can't tell slow from stalled. Ten minutes for the whole request
		# still brings a file at the app's size limit in over a slow line.
		timeouts {
			read_body 10m
		}
	}
}

{$SQUIDPDF_DOMAIN} {
	# Render's JSON carries its images as base64, which gzip wins back. PDFs are left alone.
	encode zstd gzip

	# Every path, /api/health too. The app never knows, so opening up deletes this block.
	basic_auth {
		{$SQUIDPDF_USER} {$SQUIDPDF_PASSWORD_HASH}
	}

	header {
		# HTTPS only for a year: a browser that has been here never tries plain HTTP.
		Strict-Transport-Security "max-age=31536000"
		# Each reply is the type it says: a browser never guesses a PDF or PNG is a page.
		X-Content-Type-Options "nosniff"
		# Only the app's own files and render's strips (data: URLs), so injected script never runs.
		# The hash allows React Aria's style tag (react/src/policy.test.ts). No site may frame a page.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'sha256-38RhXrc7EdReTKsOm23ZPOCUgniTUUcjky8QOOrQx6o='; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		# Another site never learns which page a request came from; ours still do.
		Referrer-Policy "same-origin"
		# The app uses none of these, so nothing on a page may ask for them.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), midi=()"
	}

	# No body cap here: the app enforces its own, and must see them.
	handle /api/* {
		# The API's docs are for development: nothing that runs behind the proxy asks for them.
		@docs path /api/docs /api/docs/* /api/openapi.json
		respond @docs 404
		reverse_proxy app:8000
	}

	# The browser app's built files, built into this image (react/Dockerfile). Each carries a hash of its
	# contents in its name, so it never changes; one the build doesn't have is missing, not the app's page.
	handle /assets/* {
		root * /srv
		# Kept for good, as it never changes. A 404 isn't kept: a later build's file must still be found.
		@built file
		header @built Cache-Control "max-age=31536000, immutable"
		file_server {
			# The brotli copy made as the image was built (react/scripts/compress.mjs), to a browser that takes it.
			precompressed br
		}
	}

	# Any other path is the app's one page: checked again on each visit, a 304 while it's the same, so a
	# deploy reaches every browser rather than leaving one on a page whose files are gone.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
