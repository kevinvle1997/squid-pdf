# Copy to .env beside compose.yaml and fill in. .env is never committed.

# A commit on main, as `git rev-parse HEAD` prints it; unset, the newest that passed every check.
SQUIDPDF_TAG=

# The domain whose DNS points at your server.
SQUIDPDF_DOMAIN=pdf.example.com

# Empty for no accounts; set, every line below is required. Generate it: openssl rand -base64 32
SQUIDPDF_SECRET=
# The sender of sign-in links, as `squid-pdf <sign-in@example.com>`; your provider must allow it.
SQUIDPDF_MAIL_FROM=
# A Brevo API key, or the SMTP lines below, never both.
SQUIDPDF_BREVO_KEY=
# Optional: a token for Brevo's hard-bounce webhook to https://<your domain>/api/account/mail-events.
SQUIDPDF_BREVO_WEBHOOK_TOKEN=
# Your mail server, as your provider names it; leave the host empty when the Brevo key is set.
SQUIDPDF_SMTP_HOST=
SQUIDPDF_SMTP_PORT=587
# tls for port 465, starttls for 587.
SQUIDPDF_SMTP_SECURITY=starttls
SQUIDPDF_SMTP_USER=
SQUIDPDF_SMTP_PASSWORD=
# yes: only people you invite (deploy/invite.sh) get in. Caddy asks no password, so this is the only gate.
SQUIDPDF_INVITE_ONLY=
# Documents a browser opens without an account, and an account a month: both, or neither for no limit.
SQUIDPDF_FREE_DOCUMENTS=
SQUIDPDF_DOCUMENTS_A_MONTH=
# A restricted Stripe key writing Customers, Checkout Sessions, the portal and Subscriptions, reading Charges.
SQUIDPDF_STRIPE_KEY=
# The signing secret (whsec_...) of a webhook to https://<your domain>/api/account/billing-events.
SQUIDPDF_STRIPE_WEBHOOK_SECRET=
# The ID (price_...) of the recurring monthly price; limit Checkout to one subscription a customer.
SQUIDPDF_STRIPE_PRICE=

# A copy of the accounts' database in object storage; turn it on before the first `up` on a new server.
#COMPOSE_FILE=compose.yaml:compose.backup.yaml
# Your bucket and folder, as s3://your-bucket/accounts?endpoint=https://fsn1.your-objectstorage.com
SQUIDPDF_BACKUP_URL=
SQUIDPDF_BACKUP_KEY_ID=
SQUIDPDF_BACKUP_SECRET=

# The server's memory less 512m for Caddy and 512m for the system; the app needs N cores x 1792m + 1024m.
SQUIDPDF_APP_MEMORY=
# N cores x 256m: an export a worker, of a file up to 100 MB plus fonts.
SQUIDPDF_APP_SCRATCH=

# A terms file on this server, as ./terms.md: "# " and a title, then paragraphs led in bold. Empty: none.
SQUIDPDF_TERMS=
