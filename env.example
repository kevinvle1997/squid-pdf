# Copy to .env beside compose.yaml and fill in. .env is never committed.

# The domain whose DNS points at your server. Caddy gets its certificate.
SQUIDPDF_DOMAIN=pdf.example.com

# Basic auth: the name you sign in with, and your password's hash from
#   docker run --rm -it caddy:2.11.4 caddy hash-password
# Keep the single quotes: they stop the $ signs in the hash being read as variables.
SQUIDPDF_USER=me
SQUIDPDF_PASSWORD_HASH='$2a$14$paste.your.hash.here'

# The app's memory, and the /tmp it saves exports in, which counts inside it. It runs one
# worker a core (nproc), each capped at 1 GiB (api/constants.py). For N cores:
#   SQUIDPDF_APP_SCRATCH is N x 256m: an export a worker, of a file up to 100 MB plus fonts.
#   SQUIDPDF_APP_MEMORY is this server's memory less 512m for Caddy and 512m for the system.
#     The app's worst case is N x 1792m (a worker, its export, two copies in the main process)
#     plus 1024m for the main process. 256m, 1024m and the system's 512m are starting values.
#     A limit past the server's memory never binds, and the server may stop Caddy instead.
# For 4 GB and 2 cores: 3072m and 512m; 3072m still holds both workers at their cap and 1024m.
# Required: compose won't start the app without them.
SQUIDPDF_APP_MEMORY=
SQUIDPDF_APP_SCRATCH=
