# Copy to .env beside compose.yaml and fill in. .env is never committed.

# The commit on main whose images a deploy pulls (compose.yaml),
# as `git rev-parse HEAD` prints it. Unset, latest: the newest commit on main every check passed on.
SQUIDPDF_TAG=

# The domain whose DNS points at your server. Caddy gets its certificate.
SQUIDPDF_DOMAIN=pdf.example.com

# Accounts, which sign in by a link sent by email. Leave the secret empty and the app keeps
# none, as a copy for yourself needs none. Set it, and every line below it is required: the
# app won't start without them. A change here reaches the app with `docker compose up -d`.
# Generate the secret, never choose one:
#   openssl rand -base64 32
SQUIDPDF_SECRET=
# The mail server that sends the links, as your provider names it: its host and port, tls
# for a connection secured from the start (465) or starttls for one upgraded (587), the user
# and password it gives you, and the address the mail comes from.
SQUIDPDF_SMTP_HOST=
SQUIDPDF_SMTP_PORT=587
SQUIDPDF_SMTP_SECURITY=starttls
SQUIDPDF_SMTP_USER=
SQUIDPDF_SMTP_PASSWORD=
SQUIDPDF_MAIL_FROM=
# Set to yes, and only people you invite sign in and open documents. Left empty, anyone who
# reaches the domain opens them: Caddy asks no password, so this is the only gate. Invite each
# person, yourself first, once the stack is up. It takes effect at once, with no restart, and
# before they ever sign in:
#   deploy/invite.sh you@example.com them@example.com
# --unlimited before the addresses lifts their document limit, for friends and family; inviting
# them again without it ends that. Taking someone off signs them out everywhere at once, and
# deletes their account; their documents go when their hour runs out, as everyone's do:
#   deploy/remove.sh them@example.com
SQUIDPDF_INVITE_ONLY=
# How many documents a browser opens without an account, and an account opens a month. Set
# both, or neither for no limit: accounts are needed to set them. Each file counts once, however
# often it's opened again. The numbers are the business's: they live here, never in the repo.
SQUIDPDF_FREE_DOCUMENTS=
SQUIDPDF_DOCUMENTS_A_MONTH=

# A copy of the accounts' database in object storage, kept as each change lands, so a lost
# server loses no one's account. backup turns it on; the URL is your bucket, a folder in it,
# and where the provider serves it, as Hetzner's Object Storage (its endpoint for your region):
#   s3://your-bucket/accounts?endpoint=https://fsn1.your-objectstorage.com&force-path-style=true
# The key's ID and secret are the bucket's, from the provider. On a new server, or after the
# accounts volume is lost, put the copy back before the first `up`: deploy/restore-accounts.sh
COMPOSE_PROFILES=
SQUIDPDF_BACKUP_URL=
SQUIDPDF_BACKUP_KEY_ID=
SQUIDPDF_BACKUP_SECRET=

# The app's memory, and the /tmp it saves exports in, which counts inside it. It runs one
# worker a core (nproc), each capped at 1 GiB (api/constants.py). For N cores:
#   SQUIDPDF_APP_SCRATCH is N x 256m: an export a worker, of a file up to 100 MB plus fonts.
#   SQUIDPDF_APP_MEMORY is this server's memory less 512m for Caddy and 512m for the system.
#     The app's worst case is N x 1792m (a worker, its export, two copies in the main process)
#     plus 1024m for the main process. 256m, 1024m and the system's 512m are starting values.
#     A limit past the server's memory never binds, and the server may stop Caddy instead.
# For 4 GB and 2 cores: 3072m and 512m; 3072m still holds both workers at their cap and 1024m.
# Required: compose won't start the app without them.
SQUIDPDF_APP_MEMORY=
SQUIDPDF_APP_SCRATCH=

# The service's terms, which the landing links: a file on this server, such as ./terms.md beside
# this one, which .gitignore keeps out of the repository. Its first line is the title, after "# ",
# in plain words, and the line under it may say when they last changed. Then paragraphs, a blank
# line apart, each opening with its lead in bold, as **Who runs this.** and the rest. An email
# address after a lead becomes a link; nothing else is formatted, and the app won't start on what
# its page can't show, so check the file first, as compose.yaml's header says. Empty: no terms.
SQUIDPDF_TERMS=
